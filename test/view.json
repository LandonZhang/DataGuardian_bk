{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "数据稽核响应",
  "type": "object",
  "required": ["success", "project", "tables", "error_message"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "是否成功理解并处理请求"
    },
    "project": {
      "type": "string",
      "description": "项目名称"
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "包含所有需要检索的表和字段信息",
        "required": ["table_name", "fields"],
        "properties": {
          "table_name": {
            "type": "string",
            "description": "表的确切名称，必须与数据库结构匹配"
          },
          "fields": {
            "type": "array",
            "description": "该表中需要检索的字段名称，必须与数据库结构匹配",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "error_message": {
      "type": "string",
      "description": "错误信息，成功时为空"
    }
  }
}
