{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "数据稽核系统API响应",
  "description": "格式化大模型对数据稽核请求的回复，包含需要检索的表名和字段名",
  "type": "object",
  "required": ["success", "tables", "error_message"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "表明大模型是否成功理解并处理了用户请求"
    },
    "tables": {
      "type": "array",
      "description": "包含所有需要检索的表和字段信息",
      "items": {
        "type": "object",
        "required": ["table_name", "fields"],
        "properties": {
          "table_name": {
            "type": "string",
            "description": "表的确切名称，必须与数据库结构匹配"
          },
          "fields": {
            "type": "array",
            "description": "该表中需要检索的字段名称",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "error_message": {
      "type": ["string", "null"],
      "description": "当无法处理用户请求时提供的错误信息，成功时为null"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "success": { "const": true } }
      },
      "then": {
        "properties": {
          "tables": { "minItems": 1 },
          "error_message": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "success": { "const": false } }
      },
      "then": {
        "properties": {
          "tables": { "maxItems": 0 },
          "error_message": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
